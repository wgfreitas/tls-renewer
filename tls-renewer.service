[Unit]
Description=TLS Certificate Auto-Renewer
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/tls-renewer
ExecStart=/opt/tls-renewer/venv/bin/python3 /opt/tls-renewer/tls_renewer.py
# Security hardening: restrict filesystem access
ProtectSystem=strict
ReadWritePaths=/opt/tls-renewer/certs /opt/tls-renewer/chain /var/log/tls-renewer
# NOTE: set ProtectHome=no if your venv points to a Python under /root (e.g. pyenv)
ProtectHome=no
NoNewPrivileges=yes
PrivateTmp=yes
# Lock file: creates writable /run/tls-renewer (sanctioned exception to strict).
# Preserve=yes prevents systemd cleanup from deleting the lock of a concurrent
# manual run (subtle race: flock on a deleted inode does not conflict).
RuntimeDirectory=tls-renewer
RuntimeDirectoryPreserve=yes

[Install]
WantedBy=multi-user.target
