# =============================================================================
# TLS-Renewer — Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env with real credentials!
# =============================================================================

# --- Directories ---
CSR_DIR=/opt/tls-renewer/csr
CERT_DIR=/opt/tls-renewer/certs
CHAIN_DIR=/opt/tls-renewer/chain
LOG_DIR=/var/log/tls-renewer

# --- API (webhook for certificate issuance) ---
API_URL=https://your-ca-api.example.com/webhook/certificado
API_USER=YOUR_API_USER
API_KEY=YOUR_API_KEY
API_TIMEOUT=300
# Set to false if the API endpoint has an incomplete certificate chain
API_VERIFY_SSL=true

# --- Renewal policy ---
# Renew certificates expiring within this number of days
RENEW_DAYS_BEFORE=30

# --- SMTP (notification email) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=tls-renewer@example.com
# Multiple recipients separated by comma
EMAIL_TO=admin@example.com
